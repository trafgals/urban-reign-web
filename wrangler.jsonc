{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urban-reign-web",
  "main": "recomp-web/_worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./recomp-web",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "DISCS",
      "bucket_name": "urban-reign-discs"
    }
  ]
}
