{
  "name": "urban-reign-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic 60Hz 3D multiplayer brawler engine — Urban Reign (Namco, 2005) modelled in the browser.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:recomp": "node scripts/test_recomp_browser.mjs",
    "report": "node tools/feel-report.mjs",
    "slice:redux": "node scripts/slice_redux.js",
    "lan-server": "node tools/lan-server.mjs",
    "signal-broker": "node tools/signal-broker.mjs",
    "pages:preview": "wrangler pages dev dist",
    "pages:deploy": "wrangler pages deploy dist --project-name urban-reign-web",
    "pages:deploy:preview": "wrangler pages deploy dist --project-name urban-reign-web --branch preview"
  },
  "dependencies": {
    "brotli": "^2.1.0",
    "brotli-dec-wasm": "^2.3.2",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "wrangler": "^4.150.0"
  }
}
